  "rescoped": [
    {
      "id": "cl_40_splash",
      "version": "11.3.0",
      "note": "This row was renamed from 'Splash' to 'Outer Radius' in 11.3.0. Inner Radius matches the old Direct damage exactly (105), so the rename is mostly cosmetic — but Outer Radius may measure a different point on the blast falloff than the old single Splash figure did. Treat the damage change at this version as possibly a definition change rather than a balance change. 11.3.0 also uses the dropoff columns on these rows for blast radius (0-0.5m inner, 0.5-3m outer) rather than bullet falloff distance."
    }
  ],

  "notes": {
    "dual_blades_alt": "Cross Slash, the secondary attack 11.0.0 added to the Dual Blades. It has its own damage and lunge distance, so it gets its own row for the same reason sword_alt does. No data sheet records it — everything known about it comes from the 11.0.0 patch notes.",
    "riot_shield_alt": "Shield Bash, the secondary attack 11.0.0 added to the Riot Shield. Fixed 40 damage and a knockback; it does not use Precision, so it has no precise-hit damage. No data sheet records it — everything known about it comes from the 11.0.0 patch notes.",
    "cl_40_direct": "Sheets 1.5 and 5.8 list a single 'CL-40' row. Later sheets split it into Direct and Splash, and 11.3.0 renames those to Inner Radius and Outer Radius. The pre-split row is mapped to cl_40_direct so the damage series stays continuous; cl_40_splash therefore first appears at the split, which is a sheet-format change, not a balance change.",
    "cl_40_splash": "Called 'Splash' through 10.0.0 and 'Outer Radius' from 11.3.0. Direct/Inner Radius damage is identical across that rename (105), but the second number is not obviously the same quantity — see the re-scope note on its 11.3.0 change.",
    "mgl_32": "Written 'MGL32' in sheets 1.5 and 5.8, 'MGL-32' from 7.3.0 onward. Same weapon.",
    "pike_556": "Listed as 'Pike' in 5.8, renamed 'Pike .556' in later sheets.",
    "dagger_alt": "Only 10.0.0 separates the plain alt-fire from the backstab alt-fire. Earlier sheets record backstab only.",
    "r_357": "Written 'R .357' in 1.5, 'R.357' elsewhere."
  }
